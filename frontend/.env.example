# Frontend Environment Configuration

# In local development:
VITE_API_URL=http://localhost:5000/api

# In production (e.g. Vercel, Netlify):
# Set this in your hosting dashboard under Environment Variables to your deployed backend URL:
# VITE_API_URL=https://your-backend-domain.onrender.com/api
#
# NOTE: If your backend and frontend are hosted together on the same domain (e.g. Render / Railway / VPS),
# you can leave VITE_API_URL empty or set it to:
# VITE_API_URL=/api

